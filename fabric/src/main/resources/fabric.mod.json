{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": ["${modAuthor}"],
  "license": "${modLicense}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.alkeari.ultimineunchained.fabric.UltimineUnchainedFabric"
    ]
  },
  "mixins": ["ultimineunchained.common.mixins.json"],
  "depends": {
    "fabricloader": ">=${depsFabricLoader}",
    "fabric-api": "*",
    "minecraft": "${minecraftRange}",
    "cloth-config2": ">=${depsClothConfig}",
    "ftbultimine": ">=${depsFtbUltimineMin}"
  }
}
